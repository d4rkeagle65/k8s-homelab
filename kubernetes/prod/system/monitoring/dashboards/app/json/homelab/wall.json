    {
      "id": 13,
      "type": "timeseries",
      "title": "Internet traffic",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 7,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "8 * sum(rate(ifHCInOctets{job=\"firewall-snmp\", ifDescr=\"dhcp\"}[5m]))",
          "legendFormat": "down"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "-8 * sum(rate(ifHCOutOctets{job=\"firewall-snmp\", ifDescr=\"dhcp\"}[5m]))",
          "legendFormat": "up"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "fillOpacity": 25,
            "lineWidth": 2,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "The firewall's WAN interface (dhcp): download above the line, upload below."
    },
