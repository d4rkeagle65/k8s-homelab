            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sort_desc(label_replace(label_replace(label_replace(sum by (ap) (wifi_stations), \"name\", \"Prod\", \"ap\", \"1\"), \"name\", \"IoT\", \"ap\", \"2\"), \"name\", \"Travel\", \"ap\", \"3\"))",
          "instant": true,
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
