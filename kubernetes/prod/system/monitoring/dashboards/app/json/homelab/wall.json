{
  "title": "Wall",
  "uid": "homelab-wall",
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "schemaVersion": 39,
  "tags": [
    "homelab",
    "wall"
