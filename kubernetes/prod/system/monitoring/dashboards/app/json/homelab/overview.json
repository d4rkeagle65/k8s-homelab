  {
   "type": "timeseries",
   "title": "CPU",
   "description": "",
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      }
     },
     "max": 100
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 * (1 - avg by (nodename) (rate(node_cpu_seconds_total{job=\"proxmox-hosts\", mode=\"idle\"}[$__rate_interval]) * on(instance) group_left(nodename) node_uname_info{job=\"proxmox-hosts\"}))",
     "legendFormat": "{{nodename}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "id": 11,
   "gridPos": {
    "x": 0,
    "y": 10,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   }
  },
  {
   "type": "timeseries",
   "title": "Memory used",
