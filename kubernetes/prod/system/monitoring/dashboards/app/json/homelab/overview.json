   "title": "Memory used",
   "description": "What each node's processes use (node-exporter inside it).",
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
