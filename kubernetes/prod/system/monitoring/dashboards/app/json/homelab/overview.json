  {
   "type": "stat",
   "title": "Pods not ready",
   "description": "Not counting Jobs' pods.",
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       },
       {
        "color": "red",
        "value": 5
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "noValue": "0"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count((kube_pod_status_ready{condition=\"false\"} == 1) unless on(namespace, pod) kube_pod_owner{owner_kind=\"Job\"}) or vector(0)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
