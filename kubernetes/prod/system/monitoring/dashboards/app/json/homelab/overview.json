    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 * max(nvme_percentage_used_ratio)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": ""
    }
   ],
   "id": 8,
   "gridPos": {
    "x": 18,
    "y": 1,
    "w": 3,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   }
  },
  {
   "type": "stat",
   "title": "Next certificate expiry",
   "description": "cert-manager renews 30 days ahead, so under 14 days means renewals are failing.",
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 604800
       },
       {
        "color": "green",
        "value": 1209600
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "noValue": "0"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "min(certmanager_certificate_expiration_timestamp_seconds) - time()",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": ""
    }
   ],
