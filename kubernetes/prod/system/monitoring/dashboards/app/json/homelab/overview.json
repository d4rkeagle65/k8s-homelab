  {
   "type": "stat",
   "title": "Oldest database backup",
   "description": "The CloudNativePG base backup that's oldest; nightly, so over 26 hours means one was missed.",
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 93600
       },
       {
        "color": "red",
        "value": 172800
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "noValue": "0"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "time() - min(barman_cloud_cloudnative_pg_io_last_available_backup_timestamp)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": ""
    }
   ],
   "id": 7,
   "gridPos": {
    "x": 15,
    "y": 1,
    "w": 3,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   }
  },
  {
   "type": "stat",
   "title": "Most worn SSD",
   "description": "The NVMe drive with the most of its rated writes used (Drives has each).",
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 80
       },
       {
        "color": "red",
        "value": 90
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "noValue": "0"
