{
  "uid": "homelab-backups",
  "title": "Backups",
  "tags": [
    "homelab",
    "backups"
  ],
  "schemaVersion": 39,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timezone": "",
  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "What this covers",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Each backup's newest copy. **Green** under 26 hours; **red** when older, or when the last attempt failed. The same conditions alert into Zammad (`homelab.backups` rules).\n\n**Covered:** Postgres (CloudNativePG, base backups and WAL to Garage), MariaDB (mariadb-operator, physical backups to Garage) and Proxmox's nightly vzdump of every guest (each host's `proxmox-backup-metrics`). **Still to come** (QUEUE-monitoring.md, phase 9): the Garage buckets of Databasus and Vaultwarden, and the Synology-to-TerraMaster copy."
      }
    },
    {
      "id": 2,
      "title": "Postgres (CloudNativePG)",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 9
      },
      "description": "Base backups nightly (media-backup/ and each app's ScheduledBackup); WAL archived continuously. A quiet database archives WAL rarely, so its WAL hours aren't an alarm on their own.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "(time() - cnpg:backup_last_available_timestamp:max) / 3600",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "(cnpg:backup_last_failed_timestamp:max > bool on (namespace, cluster) cnpg:backup_last_available_timestamp:max) or on (namespace, cluster) (cnpg:backup_last_available_timestamp:max * 0)",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "cnpg:archiver_seconds_since_last_archival:min / 3600",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge"
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "namespace": "Namespace",
              "cluster": "Database",
              "Value #A": "Hours since backup",
              "Value #B": "Last attempt failed",
              "Value #C": "Hours since WAL archived"
            },
            "indexByName": {
              "Namespace": 0,
              "Database": 1,
              "Hours since backup": 2,
              "Last attempt failed": 3,
              "Hours since WAL archived": 4
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Hours since backup"
            },
            "properties": [
              {
                "id": "unit",
                "value": "h"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 26
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last attempt failed"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "no",
                        "color": "green"
                      },
                      "1": {
                        "text": "FAILED",
                        "color": "red"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Completed"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "yes",
                        "color": "green"
                      },
                      "0": {
                        "text": "NO",
                        "color": "red"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Hours since WAL archived"
            },
            "properties": [
              {
                "id": "unit",
                "value": "h"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Hours since backup",
            "desc": true
          }
        ]
      }
    },
    {
