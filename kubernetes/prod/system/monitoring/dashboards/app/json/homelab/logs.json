{
  "uid": "homelab-logs",
  "title": "Logs",
  "tags": [
    "homelab",
    "logs"
  ],
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "",
  "editable": true,
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Machine",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "definition": "label_values(host)",
        "query": "label_values(host)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "definition": "label_values(namespace)",
        "query": "label_values(namespace)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "app",
        "label": "App",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "definition": "label_values({namespace=~\"$namespace\"}, app)",
        "query": "label_values({namespace=~\"$namespace\"}, app)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "search",
        "label": "Text",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "How to search",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Logs from the cluster (labels **namespace**, **app**, **container**, **node**, **stream**) and from the machines outside it (**host**, **source**: journal, docker, pihole, syslog; **app**: the unit, container or program). The text box filters every log panel (case-insensitive, a regular expression). A pod is structured metadata, not a label: in Explore, add `| pod=\"name\"` after the selector. Kept 14 days."
      }
    },
    {
      "id": 2,
      "title": "Lines per machine outside the cluster",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Each machine's log lines; a machine that drops to nothing is silent (the HostLogsSilent alert, after 6 hours).",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum by (host) (count_over_time({source=~\"journal|docker|pihole|syslog\", host=~\"$host\"} [$__auto]))",
          "legendFormat": "{{host}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "title": "Lines per namespace",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "The cluster's log lines; a spike is usually one app in a loop.",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "sum by (namespace) (count_over_time({namespace=~\"$namespace\"} [$__auto]))",
          "legendFormat": "{{namespace}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "title": "Error lines by app, over the range",
      "type": "table",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 9
      },
      "description": "Lines that look like errors (level=error/fatal, \"error\", \"panic\"; not a request log's empty error=\"<nil>\" field), counted per app over the dashboard's time range, inside and outside the cluster.",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "queryType": "instant",
          "expr": "topk(20, sum by (namespace, app) (count_over_time({namespace=~\"$namespace\"} |~ `(?i)(level=(error|fatal|crit)|\"level\":\"(error|fatal)\"|\\berror\\b|\\bfatal\\b|\\bpanic\\b)` !~ `error=\"<nil>\"|\"error\":null` [$__range])) or sum by (host, app) (count_over_time({source=~\"journal|docker|pihole|syslog\", host=~\"$host\"} |~ `(?i)(level=(error|fatal|crit)|\"level\":\"(error|fatal)\"|\\berror\\b|\\bfatal\\b|\\bpanic\\b)` !~ `error=\"<nil>\"|\"error\":null` [$__range])))",
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "lastNotNull"
            ],
            "mode": "seriesToRows"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Field": "Source",
              "Last *": "Error lines"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Error lines",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 5,
      "title": "SSH logins and failures",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Every machine's sshd: logins accepted, and failures.",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "{app=~\"ssh|sshd\", host=~\"$host\"} |~ `Accepted|Failed password|Invalid user|authentication failure`",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      }
    },
    {
      "id": 6,
      "title": "Machines outside the cluster",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Journal, Docker, Pi-hole and syslog lines from the Proxmox hosts, Pi-holes, Docker VMs and NASes, filtered by host and the text box.",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "{source=~\"journal|docker|pihole|syslog\", host=~\"$host\"} |~ `(?i)$search`",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      }
    },
    {
      "id": 7,
      "title": "Cluster",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Pod logs, filtered by namespace, app and the text box.",
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "{namespace=~\"$namespace\", app=~\"$app\"} |~ `(?i)$search`",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      }
    }
  ]
}
