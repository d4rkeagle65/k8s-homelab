+  /**
+   * A saved opt-in (--ez swipe true) for pages that step with the arrow keys, such as a
+   * slideshow: a one-finger swipe left sends Right (next), a swipe right sends Left (previous).
+   * Off by default, as a page with its own sideways scrolling would get both.
+   */
+  private void applySwipeFlag(Intent intent) {
+    if (intent != null && intent.hasExtra(PREF_SWIPE)) {
+      getSharedPreferences(PREFS, MODE_PRIVATE).edit()
+          .putBoolean(PREF_SWIPE, intent.getBooleanExtra(PREF_SWIPE, false)).apply();
+    }
+    swipeOn = getSharedPreferences(PREFS, MODE_PRIVATE).getBoolean(PREF_SWIPE, false);
+  }
+
+  /** A saved opt-in (--ez mute_at_start true): media starts muted each time Home HQ starts. */
+  private void applyMuteAtStartFlag(Intent intent) {
+    if (intent != null && intent.hasExtra(PREF_MUTE_AT_START)) {
+      getSharedPreferences(PREFS, MODE_PRIVATE).edit()
+          .putBoolean(PREF_MUTE_AT_START, intent.getBooleanExtra(PREF_MUTE_AT_START, false)).apply();
+    }
+  }
+
+  /** Whether this lift ends a swipe; if so the page gets the arrow key, and no tap. */
+  private boolean endSwipe(MotionEvent e) {
+    if (!swipeOn || !swipeOneFinger) return false;
+    float dx = e.getX() - swipeX, dy = e.getY() - swipeY;
+    if (Math.abs(dx) < SWIPE_MIN_PX || Math.abs(dx) < 2 * Math.abs(dy)
+        || SystemClock.uptimeMillis() - swipeTime > SWIPE_MAX_MS) return false;
+    cancelPageTouches();
+    int key = dx < 0 ? KeyEvent.KEYCODE_DPAD_RIGHT : KeyEvent.KEYCODE_DPAD_LEFT;
+    web.requestFocus();
+    web.dispatchKeyEvent(new KeyEvent(KeyEvent.ACTION_DOWN, key));
+    web.dispatchKeyEvent(new KeyEvent(KeyEvent.ACTION_UP, key));
+    return true;
+  }
+
+  /**
+   * The mute key toggles media's mute. On a frame whose power button is remapped to
+   * VOLUME_MUTE in its key layout, one press of that button mutes or unmutes the page.
+   */
+  @Override
+  public boolean dispatchKeyEvent(KeyEvent e) {
+    if (e.getKeyCode() == KeyEvent.KEYCODE_VOLUME_MUTE) {
+      if (e.getAction() == KeyEvent.ACTION_DOWN && e.getRepeatCount() == 0) {
+        AudioManager audio = (AudioManager) getSystemService(Context.AUDIO_SERVICE);
+        audio.adjustStreamVolume(AudioManager.STREAM_MUSIC, AudioManager.ADJUST_TOGGLE_MUTE,
+            AudioManager.FLAG_SHOW_UI);
+      }
+      return true;
+    }
+    return super.dispatchKeyEvent(e);
+  }
