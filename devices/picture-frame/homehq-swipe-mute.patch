+
+  private void startCommandServer(String token) {
+    final ServerSocket server;
+    try {
+      server = new ServerSocket(COMMAND_PORT);
+    } catch (IOException e) {
+      Log.w(TAG, "Commands off: port " + COMMAND_PORT + " unavailable (" + e.getMessage() + ")");
+      return;
+    }
+    commandSocket = server;
+    final byte[] expected = token.getBytes(StandardCharsets.UTF_8);
+    Thread t = new Thread(() -> {
+      while (!server.isClosed()) {
+        try (Socket s = server.accept()) {
+          handleCommand(s, expected);
+        } catch (IOException e) {
+          if (!server.isClosed()) Log.w(TAG, "Command connection failed (" + e.getMessage() + ")");
+        }
+      }
+    }, "commands");
+    t.setDaemon(true);
+    t.start();
+    Log.i(TAG, "Commands on, port " + COMMAND_PORT);
+  }
+
+  private void stopCommandServer() {
+    if (commandSocket == null) return;
+    try {
+      commandSocket.close();
+    } catch (IOException ignored) {
+      // Closing is all that's wanted; the accept loop ends either way.
+    }
+    commandSocket = null;
+  }
+
+  /** One request: the method, the path and the X-Token header; the body is ignored. */
+  private void handleCommand(Socket s, byte[] expected) throws IOException {
+    s.setSoTimeout(COMMAND_READ_TIMEOUT_MS);
+    BufferedReader in = new BufferedReader(new InputStreamReader(s.getInputStream(), StandardCharsets.UTF_8));
+    String[] request = String.valueOf(in.readLine()).split(" ");
+    String given = "";
+    for (int i = 0; i < COMMAND_MAX_HEADER_LINES; i++) {
+      String line = in.readLine();
+      if (line == null || line.isEmpty()) break;
+      int colon = line.indexOf(':');
+      if (colon > 0 && line.substring(0, colon).trim().equalsIgnoreCase("X-Token")) {
+        given = line.substring(colon + 1).trim();
+      }
+    }
+    String method = request[0];
+    String path = request.length > 1 ? request[1] : "";
+    int status;
+    if (!MessageDigest.isEqual(expected, given.getBytes(StandardCharsets.UTF_8))) {
+      status = 401;
+    } else if (!"POST".equals(method)) {
+      status = 405;
+    } else {
+      status = runCommand(path) ? 200 : 404;
+    }
+    if (status != 200) Log.w(TAG, "Command refused: " + status + " " + method + " " + path);
+    String body = status == 200 ? "ok\n" : status + "\n";
+    OutputStream out = s.getOutputStream();
+    out.write(("HTTP/1.1 " + status + " " + (status == 200 ? "OK" : "Error") + "\r\n"
+        + "Content-Type: text/plain\r\nContent-Length: " + body.length()
+        + "\r\nConnection: close\r\n\r\n" + body).getBytes(StandardCharsets.UTF_8));
+    out.flush();
+  }
+
+  /** Whether the path is a command; each runs on the UI thread (reboot through the firmware's su). */
+  private boolean runCommand(String path) {
+    final Runnable action;
+    switch (path) {
+      case "/next": action = () -> sendPageKey(KeyEvent.KEYCODE_DPAD_RIGHT); break;
+      case "/back": action = () -> sendPageKey(KeyEvent.KEYCODE_DPAD_LEFT); break;
+      case "/pause": action = () -> sendPageKey(KeyEvent.KEYCODE_SPACE); break;
+      case "/mute": action = this::toggleMute; break;
+      case "/reboot":
+        action = () -> {
+          try {
+            Runtime.getRuntime().exec(new String[] {"su", "-c", "reboot"});
+          } catch (IOException e) {
+            Log.w(TAG, "Reboot failed (" + e.getMessage() + ")");
+          }
+        };
+        break;
+      default:
+        return false;
+    }
+    Log.i(TAG, "Command " + path);
+    // After the reply has gone, so a reboot doesn't cut it off.
+    handler.postDelayed(action, 100);
+    return true;
+  }
+
+  /**
+   * The mute key toggles media's mute. On a frame whose power button is remapped to
+   * VOLUME_MUTE in its key layout, one press of that button mutes or unmutes the page.
+   */
+  @Override
+  public boolean dispatchKeyEvent(KeyEvent e) {
+    if (e.getKeyCode() == KeyEvent.KEYCODE_VOLUME_MUTE) {
+      if (e.getAction() == KeyEvent.ACTION_DOWN && e.getRepeatCount() == 0) toggleMute();
+      return true;
+    }
+    return super.dispatchKeyEvent(e);
+  }
