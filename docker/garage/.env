# Every variable compose.yaml uses, as its Key Vault reference: Dockhand resolves them at
# each deploy, with the vault bound as this stack's secret provider and its selector
# empty (docker/CLAUDE.md). Populate imports them as they are. Never a value here.
TERRAMASTER_MGMT_ADDRESS=azurekv://TERRAMASTER-MGMT-ADDRESS
GARAGE_DIR=azurekv://GARAGE-DIR
GARAGE_RPC_SECRET=azurekv://GARAGE-RPC-SECRET
GARAGE_ADMIN_TOKEN=azurekv://GARAGE-ADMIN-TOKEN
GARAGE_METRICS_TOKEN=azurekv://GARAGE-METRICS-TOKEN
CNPG_BACKUP_S3_ACCESS_KEY_ID=azurekv://CNPG-BACKUP-S3-ACCESS-KEY-ID
CNPG_BACKUP_S3_SECRET_ACCESS_KEY=azurekv://CNPG-BACKUP-S3-SECRET-ACCESS-KEY
