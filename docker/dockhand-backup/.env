# Every variable compose.yaml uses, as its Key Vault reference: Dockhand resolves them at
# each deploy, with the vault bound as this stack's secret provider and its selector
# empty (docker/CLAUDE.md). Populate imports them as they are. Never a value here.
DOCKHAND_BACKUP_ZIP_PASSWORD=azurekv://DOCKHAND-BACKUP-ZIP-PASSWORD
GARAGE_S3_ENDPOINT=azurekv://GARAGE-S3-ENDPOINT
VAULTWARDEN_BACKUP_S3_ACCESS_KEY_ID=azurekv://VAULTWARDEN-BACKUP-S3-ACCESS-KEY-ID
VAULTWARDEN_BACKUP_S3_SECRET_ACCESS_KEY=azurekv://VAULTWARDEN-BACKUP-S3-SECRET-ACCESS-KEY
