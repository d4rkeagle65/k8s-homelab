# Every variable compose.yaml uses, as its Key Vault reference: Dockhand resolves them at
# each deploy, with the vault bound as this stack's secret provider and its selector
# empty (docker/CLAUDE.md). Populate imports them as they are. Never a value here.
DOCKER_VM_1_MGMT_ADDRESS=azurekv://DOCKER-VM-1-MGMT-ADDRESS
BASE_DOMAIN=azurekv://BASE-DOMAIN
NETBOX_DB_PASSWORD=azurekv://NETBOX-DB-PASSWORD
NETBOX_SECRET_KEY=azurekv://NETBOX-SECRET-KEY
NETBOX_API_TOKEN_PEPPER=azurekv://NETBOX-API-TOKEN-PEPPER
AUTHENTIK_NETBOX_OIDC_CLIENT_SECRET=azurekv://AUTHENTIK-NETBOX-OIDC-CLIENT-SECRET
DATABASUS_NETBOX_DB_PASSWORD=azurekv://DATABASUS-NETBOX-DB-PASSWORD
TIMEZONE=azurekv://TIMEZONE
NETBOX_DNS_SYNC_TOKEN=azurekv://NETBOX-DNS-SYNC-TOKEN
PIHOLE_1_URL=azurekv://PIHOLE-1-URL
PIHOLE_1_PASSWORD=azurekv://PIHOLE-1-PASSWORD
PIHOLE_2_URL=azurekv://PIHOLE-2-URL
PIHOLE_2_PASSWORD=azurekv://PIHOLE-2-PASSWORD
