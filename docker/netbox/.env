# Every variable compose.yaml uses, blank, so Dockhand's Populate can list them.
# Set the values in Dockhand, marked secret (Dockhand passes those to compose
# directly, and they override this file); never fill them in here.
NETBOX_BIND_ADDRESS=
NETBOX_HOST=
NETBOX_DB_PASSWORD=
NETBOX_SECRET_KEY=
NETBOX_API_TOKEN_PEPPER=
OIDC_ENDPOINT=
OIDC_CLIENT_SECRET=
CONFIG_DIFF_USERNAME=
CONFIG_DIFF_PASSWORD=
KEA_NETWORK=
DATABASUS_DB_PASSWORD=
TZ=
NETBOX_DNS_SYNC_TOKEN=
PIHOLE_1_URL=
PIHOLE_1_PASSWORD=
PIHOLE_2_URL=
PIHOLE_2_PASSWORD=
PIHOLE_TLS_VERIFY=
SYNC_APPLY=
SYNC_DELETE=
