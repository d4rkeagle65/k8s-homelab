# Every variable compose.yaml uses, as its Key Vault reference: Dockhand resolves them at
# each deploy, with the vault bound as this stack's secret provider and its selector
# empty (docker/CLAUDE.md). Populate imports them as they are. Never a value here.
DOCKER_VM_1_MGMT_ADDRESS=azurekv://DOCKER-VM-1-MGMT-ADDRESS
BASE_DOMAIN=azurekv://BASE-DOMAIN
SEMAPHORE_DB_PASSWORD=azurekv://SEMAPHORE-DB-PASSWORD
SEMAPHORE_ADMIN_PASSWORD=azurekv://SEMAPHORE-ADMIN-PASSWORD
SEMAPHORE_ADMIN_EMAIL=azurekv://SEMAPHORE-ADMIN-EMAIL
SEMAPHORE_ACCESS_KEY_ENCRYPTION=azurekv://SEMAPHORE-ACCESS-KEY-ENCRYPTION
SEMAPHORE_COOKIE_HASH=azurekv://SEMAPHORE-COOKIE-HASH
SEMAPHORE_COOKIE_ENCRYPTION=azurekv://SEMAPHORE-COOKIE-ENCRYPTION
TFSTATE_DB_PASSWORD=azurekv://TFSTATE-DB-PASSWORD
DATABASUS_SEMAPHORE_DB_PASSWORD=azurekv://DATABASUS-SEMAPHORE-DB-PASSWORD
TIMEZONE=azurekv://TIMEZONE
NETBOX_SEMAPHORE_TOKEN=azurekv://NETBOX-SEMAPHORE-TOKEN
# Set in Dockhand, marked secret, until Key Vault holds it plain (it's base64 there).
SEMAPHORE_OIDC_CLIENT_SECRET=
