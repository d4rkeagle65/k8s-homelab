# Every variable compose.yaml uses, blank, so Dockhand's Populate can list them.
# Set the values in Dockhand, marked secret (Dockhand passes those to compose
# directly, and they override this file); never fill them in here.
SEMAPHORE_BIND_ADDRESS=
SEMAPHORE_WEB_ROOT=
SEMAPHORE_DB_PASSWORD=
SEMAPHORE_ADMIN_PASSWORD=
SEMAPHORE_ADMIN_EMAIL=
SEMAPHORE_ACCESS_KEY_ENCRYPTION=
SEMAPHORE_COOKIE_HASH=
SEMAPHORE_COOKIE_ENCRYPTION=
SEMAPHORE_OIDC_ISSUER_URL=
SEMAPHORE_OIDC_CLIENT_SECRET=
TFSTATE_DB_PASSWORD=
TZ=
DATABASUS_DB_PASSWORD=
