#!/bin/bash
# Usage: setup-kubeconfig <API server URL>
# Writes .kube/config for the claude-code ServiceAccount
# (kubernetes/prod/system/cluster-access/claude-code/), from its token Secret's data, pasted on
# one line, under the credentials directory (CREDS_DIR, the host's
# /opt/claude-code/creds; ~ if it's unset). On the PC, this prints that data:
#   kubectl -n cluster-access get secret claude-code-token -o jsonpath='{.data}'
# The API server URL is the same as in the PC's kubeconfig. The lanes mount the
# credentials directory read-only, so run this against it from the host
# (README.md, Credentials), not inside a lane.
set -euo pipefail

server="${1:?usage: setup-kubeconfig https://<API server>:6443}"
base="${CREDS_DIR:-$HOME}"

IFS= read -rs -p "Paste the token Secret's data, then press Enter: " data
echo >&2
data="${data%$'\r'}"

ca="$(mktemp)"
trap 'rm -f "$ca"' EXIT
jq -er '."ca.crt"' <<<"$data" | base64 -d > "$ca"
token="$(jq -er '.token' <<<"$data" | base64 -d)"
unset data

umask 077
mkdir -p "$base/.kube"
export KUBECONFIG="$base/.kube/config"
kubectl config set-cluster homelab --server="$server" \
    --certificate-authority="$ca" --embed-certs=true >/dev/null
kubectl config set-credentials claude-code --token="$token" >/dev/null
unset token
kubectl config set-context homelab --cluster=homelab --user=claude-code >/dev/null
kubectl config use-context homelab >/dev/null

echo "Wrote $KUBECONFIG. Checking it:" >&2
kubectl auth whoami
