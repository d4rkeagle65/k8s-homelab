#!/bin/bash
# Usage: setup-kubeconfig <API server URL>
# Writes ~/.kube/config for the claude-code ServiceAccount
# (kubernetes/apps/claude-code/), from its token Secret's data, pasted on
# one line. On the PC, this prints that data:
#   kubectl -n claude-code get secret claude-code-token -o jsonpath='{.data}'
# The API server URL is the same as in the PC's kubeconfig.
set -euo pipefail

server="${1:?usage: setup-kubeconfig https://<API server>:6443}"

IFS= read -rs -p "Paste the token Secret's data, then press Enter: " data
echo >&2
data="${data%$'\r'}"

ca="$(mktemp)"
trap 'rm -f "$ca"' EXIT
jq -er '."ca.crt"' <<<"$data" | base64 -d > "$ca"
token="$(jq -er '.token' <<<"$data" | base64 -d)"
unset data

umask 077
mkdir -p "$HOME/.kube"
export KUBECONFIG="$HOME/.kube/config"
kubectl config set-cluster homelab --server="$server" \
    --certificate-authority="$ca" --embed-certs=true >/dev/null
kubectl config set-credentials claude-code --token="$token" >/dev/null
unset token
kubectl config set-context homelab --cluster=homelab --user=claude-code >/dev/null
kubectl config use-context homelab >/dev/null

echo "Wrote ~/.kube/config. Checking it:" >&2
kubectl auth whoami
