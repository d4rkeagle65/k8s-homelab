#!/bin/bash
# Usage: save-secret <file>
# Reads one line from the terminal without showing it and saves it, readable
# only by this user, under the credentials directory (CREDS_DIR, the host's
# /opt/claude-code/creds; ~ if it's unset). For credentials that are a single
# line, such as .proxmox-token and .kea-api. The lanes mount the credentials
# directory read-only, so run this against it from the host (README.md,
# Credentials), not inside a lane.
set -euo pipefail

[ $# -eq 1 ] || { echo "usage: save-secret <file, relative to the credentials dir>" >&2; exit 2; }
base="${CREDS_DIR:-$HOME}"
dest="$base/$1"

IFS= read -rs -p "Paste the value for $1, then press Enter: " value
echo >&2
value="${value%$'\r'}"
[ -n "$value" ] || { echo "Nothing pasted; $1 unchanged." >&2; exit 1; }

umask 077
mkdir -p "$(dirname "$dest")"
printf '%s\n' "$value" > "$dest"
echo "Saved $dest." >&2
