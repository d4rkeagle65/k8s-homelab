#!/bin/bash
# Usage: save-secret <file>
# Reads one line from the terminal without showing it and saves it as
# ~/<file>, readable only by this user. For credentials that are a single
# line, such as ~/.proxmox-token and ~/.kea-api (see README.md).
set -euo pipefail

[ $# -eq 1 ] || { echo "usage: save-secret <file, relative to ~>" >&2; exit 2; }
dest="$HOME/$1"

IFS= read -rs -p "Paste the value for ~/$1, then press Enter: " value
echo >&2
value="${value%$'\r'}"
[ -n "$value" ] || { echo "Nothing pasted; ~/$1 unchanged." >&2; exit 1; }

umask 077
mkdir -p "$(dirname "$dest")"
printf '%s\n' "$value" > "$dest"
echo "Saved ~/$1." >&2
