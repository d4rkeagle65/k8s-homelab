#!/bin/bash
# One container per lane. This script is the image's entrypoint (Dockerfile
# ENTRYPOINT ["claude-code-start"]); compose passes the lane's short name as the
# argument (compose.yaml `command:`), e.g. `main` or `netbox`.
#
# A lane is one Claude Code process with Remote Control on, working in its own
# clone of this repo at ~/<lane> and making a branch per change (README.md,
# Lanes). It runs in a tmux session named "claude" (one window) so you can
# attach: docker exec -it claude-code-<lane> tmux attach -t claude
# Ctrl-b then d detaches; Ctrl-c in the window stops the lane until it restarts.
#
# All lanes share the home folder /home/claude (the login, settings,
# ~/.claude.json and each lane's conversations, kept apart by the clone's path),
# and read the infra credentials from /opt/creds, mounted read-only (README.md,
# Credentials): start-up links them into their usual ~/ paths so the repo's
# scripts find them, and no lane can change them.
set -euo pipefail

prefix="${REMOTE_CONTROL_NAME:-homelab}"
self="$(readlink -f "$0")"
creds="${CREDS_DIR:-/opt/creds}"

# Lane lifecycle events (a lane coming up, Claude exiting and restarting) go to a
# small file in /tmp that the supervisor relays to the container's stdout with
# tail, so `docker logs` and Loki see them. A lane runs inside tmux, whose panes
# never reach stdout, so it writes events to the file rather than its own stdout.
# Logging never fails a lane (errors are ignored).
events="/tmp/claude-events.log"
log() { printf '%s [%s] %s\n' "$(date -u +%FT%TZ)" "${LANE_NAME:-supervisor}" "$*" >> "$events" 2>/dev/null || true; }

# Pre-trust a lane's clone folder so Claude Code never stops at the interactive
# "Do you trust the files in this folder?" prompt on a fresh clone (README.md,
# Lanes). Folder trust lives only in the shared ~/.claude.json, at
# projects["<path>"].hasTrustDialogAccepted; Claude Code 2.1 has no settings key,
# env var or flag for it. The lanes share one ~/.claude.json, so the update is
# serialized across containers with flock and merged with jq, never a blind
# overwrite that would drop another lane's entry. It's skipped when the folder is
# already trusted, so a redeploy writes nothing and can't race a running lane's
# own writes to the file; a real write happens only on a first deploy (before any
# lane has cloned, so no Claude process is running yet) or when a brand-new lane
# first starts. A failure here just leaves the prompt in place, as before; it
# never stops the lane. Prints its result to stdout (docker logs), not the events
# file, which isn't set up yet when this runs.
trust_folder() {
    local path="$1" cfg="$HOME/.claude.json" lock="$HOME/.claude.json.trust.lock"
    command -v jq >/dev/null 2>&1 || { echo "folder trust: jq missing; left to the prompt"; return 0; }
    if [ -f "$cfg" ] && jq -e --arg p "$path" \
            '.projects[$p].hasTrustDialogAccepted == true' "$cfg" >/dev/null 2>&1; then
        return 0
    fi
    (
        set +e
        flock -w 30 9 || { echo "folder trust: config lock busy; left to the prompt"; exit 0; }
        cur='{}'
        if [ -f "$cfg" ] && ! cur="$(jq -e . "$cfg" 2>/dev/null)"; then
            echo "folder trust: ~/.claude.json is not valid JSON; left to the prompt"; exit 0
        fi
        tmp="$(mktemp "$cfg.XXXXXX" 2>/dev/null)" || exit 0
        if printf '%s' "$cur" | jq --arg p "$path" \
                '.projects[$p].hasTrustDialogAccepted = true' > "$tmp" 2>/dev/null; then
            mv -f "$tmp" "$cfg" 2>/dev/null || rm -f "$tmp"
        else
            rm -f "$tmp"
        fi
        exit 0
    ) 9>"$lock"
    if jq -e --arg p "$path" '.projects[$p].hasTrustDialogAccepted == true' "$cfg" >/dev/null 2>&1; then
        echo "folder trust: $path is trusted"
    else
        echo "folder trust: not confirmed for $path; the prompt may appear"
    fi
    return 0
}

# Turn on remoteControlAtStartup in the shared user settings so every lane
# re-establishes its Remote Control session on each start. A redeploy recreates
# the container, which drops the Remote Control session recorded in the lane's
# conversation; `claude --continue` only reconnects a session the server still
# has, so without this a lane comes up offline after a redeploy. The setting is
# user-level (a project or local setting is ignored). The lanes share one
# settings.json, so the update is serialized across containers with flock and
# merged with jq, never a blind overwrite that would drop another lane's keys.
# It's skipped when already set, so a redeploy writes nothing and can't race a
# running lane. A failure here just leaves the setting as it was; it never stops
# the lane. Prints its result to stdout (docker logs), not the events file, which
# isn't set up yet when this runs.
ensure_remote_control_at_startup() {
    local cfg="$HOME/.claude/settings.json" lock="$HOME/.claude/.settings.rc.lock"
    command -v jq >/dev/null 2>&1 || { echo "remote control: jq missing; remoteControlAtStartup left unset"; return 0; }
    mkdir -p "$HOME/.claude" 2>/dev/null || true
    if [ -f "$cfg" ] && jq -e '.remoteControlAtStartup == true' "$cfg" >/dev/null 2>&1; then
        return 0
    fi
    (
        set +e
        flock -w 30 9 || { echo "remote control: settings lock busy; remoteControlAtStartup left unset"; exit 0; }
        cur='{}'
        if [ -f "$cfg" ] && ! cur="$(jq -e . "$cfg" 2>/dev/null)"; then
            echo "remote control: settings.json is not valid JSON; remoteControlAtStartup left unset"; exit 0
        fi
        tmp="$(mktemp "$cfg.XXXXXX" 2>/dev/null)" || exit 0
        if printf '%s' "$cur" | jq '.remoteControlAtStartup = true' > "$tmp" 2>/dev/null; then
            mv -f "$tmp" "$cfg" 2>/dev/null || rm -f "$tmp"
        else
            rm -f "$tmp"
        fi
        exit 0
    ) 9>"$lock"
    if jq -e '.remoteControlAtStartup == true' "$cfg" >/dev/null 2>&1; then
        echo "remote control: remoteControlAtStartup is on"
    else
        echo "remote control: remoteControlAtStartup not confirmed; a lane may stay offline after a redeploy"
    fi
    return 0
}

# Run this lane's Claude Code, again whenever it exits. Claude Code keeps each
# folder's conversations in ~/.claude/projects/, in a folder named after the path
# with every character other than a letter or digit turned into "-". If there are
# any (a restart, a redeploy, or one copied in from another machine), continue the
# newest; otherwise start a new one and name its Remote Control session.
#
# Remote Control is re-established on every start by remoteControlAtStartup in the
# shared settings (ensure_remote_control_at_startup, above): a redeploy recreates
# the container and drops the Remote Control session recorded in the conversation,
# so `claude --continue` alone has nothing live to reconnect and the lane would
# come up offline. --remote-control "$rc_name" still goes on a brand-new lane's
# first start, to set the session's display name; it is not passed on a resume,
# where re-registering a still-live id returns HTTP 403 and would run with Remote
# Control off.
if [ "${1:-}" = "--run" ]; then
    dir="$2" rc_name="$3" LANE_NAME="$3"
    cd "$dir"
    project="$HOME/.claude/projects/$(printf '%s' "$dir" | sed 's/[^A-Za-z0-9]/-/g')"
    log "lane up in $dir"
    while true; do
        if compgen -G "$project/*.jsonl" >/dev/null; then
            args=(--continue)
        else
            args=(--remote-control "$rc_name")
        fi
        rc=0; claude "${args[@]}" || rc=$?
        log "claude exited (status $rc); restarting in 10s"
        echo "Claude Code exited; starting it again in 10 seconds (Ctrl-c to stop this lane)."
        sleep 10
    done
fi

# --- supervisor: this container's one lane, named by the argument ---
lane="${1:?no lane name given (compose.yaml command:)}"
if ! [[ "$lane" =~ ^[A-Za-z0-9-]+$ ]]; then
    echo "lane '$lane': only letters, digits and - are allowed" >&2
    exit 2
fi
dir="$HOME/$lane"
# Its Remote Control name, "<prefix> - <display>", so lanes are told apart at
# claude.ai/code and in the Claude app. The display name is the lane's optional
# second argument (compose.yaml command:, e.g. [l3, Research]); without one it's
# the lane name capitalised. Either way this only sets the name a lane first
# registers under: rename a lane once at claude.ai to lock it (README.md, Lanes).
display="${2:-${lane^}}"
rc_name="$prefix - $display"

# Trust this lane's clone before anything runs in it (trust_folder, above). Done
# before the clone: on a cold deploy every lane is trusted before any Claude
# process starts and could write the shared ~/.claude.json.
trust_folder "$(realpath -m "$dir" 2>/dev/null || printf '%s' "$dir")"

# Turn on remoteControlAtStartup once, so this lane re-registers Remote Control on
# every start and comes back online after a redeploy (ensure_remote_control_at_startup).
ensure_remote_control_at_startup

# Link each read-only credential from /opt/creds into its usual ~/ path (the
# repo's scripts read ~/.proxmox-token, ~/.kube/config and so on). The link
# overwrites a stale real file from an earlier layout; a credential the host
# doesn't have is simply not linked. The targets stay read-only: a lane reads
# them, never writes them (README.md, Credentials).
if [ -d "$creds" ]; then
    while IFS= read -r rel; do
        rel="${rel#./}"
        mkdir -p "$HOME/$(dirname "$rel")"
        ln -sf "$creds/$rel" "$HOME/$rel"
    done < <(cd "$creds" && find . -type f 2>/dev/null)
fi

# Clone this lane's own copy on first start (each lane clones separately, so
# parallel first starts don't race on one repo), then set the repo's hooks (the
# pre-commit hook runs scripts/tests before each commit).
if [ ! -d "$dir/.git" ]; then
    git clone --quiet "${REPO_URL:?REPO_URL is not set}" "$dir"
fi
git -C "$dir" config core.hooksPath .githooks

# Relay lane events to the container's stdout (docker logs / Loki) for the
# container's life: truncate the file, then follow it. Killed on stop (below).
: > "$events"
tail -n +1 -F "$events" 2>/dev/null &
tail_pid=$!
log "container starting; lane $lane ($rc_name)"

tmux new-session -d -s claude -x 240 -y 60 -n "$rc_name" -c "$dir" \
    "$self" --run "$dir" "$rc_name"

# On docker stop, end the session cleanly instead of waiting to be killed.
trap 'log "stopping"; tmux kill-server 2>/dev/null || true; kill "$tail_pid" 2>/dev/null || true; exit 0' TERM INT
while tmux has-session -t claude 2>/dev/null; do
    sleep 15 &
    wait $!
done
