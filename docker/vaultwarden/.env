# Every variable compose.yaml uses, as its Key Vault reference: Dockhand resolves them at
# each deploy, with the vault bound as this stack's secret provider and its selector
# empty (docker/CLAUDE.md). Populate imports them as they are. Never a value here.
DOCKER_VM_1_PROD_ADDRESS=azurekv://DOCKER-VM-1-PROD-ADDRESS
BASE_DOMAIN=azurekv://BASE-DOMAIN
VAULTWARDEN_ADMIN_TOKEN=azurekv://VAULTWARDEN-ADMIN-TOKEN
M365_SHARED_MAILBOX_ADDRESS=azurekv://M365-SHARED-MAILBOX-ADDRESS
ENTRA_VAULTWARDEN_SMTP_USERNAME=azurekv://ENTRA-VAULTWARDEN-SMTP-USERNAME
ENTRA_VAULTWARDEN_SMTP_CLIENT_SECRET=azurekv://ENTRA-VAULTWARDEN-SMTP-CLIENT-SECRET
AUTHENTIK_VAULTWARDEN_OIDC_CLIENT_ID=azurekv://AUTHENTIK-VAULTWARDEN-OIDC-CLIENT-ID
AUTHENTIK_VAULTWARDEN_OIDC_CLIENT_SECRET=azurekv://AUTHENTIK-VAULTWARDEN-OIDC-CLIENT-SECRET
GARAGE_S3_ENDPOINT=azurekv://GARAGE-S3-ENDPOINT
VAULTWARDEN_BACKUP_S3_ACCESS_KEY_ID=azurekv://VAULTWARDEN-BACKUP-S3-ACCESS-KEY-ID
VAULTWARDEN_BACKUP_S3_SECRET_ACCESS_KEY=azurekv://VAULTWARDEN-BACKUP-S3-SECRET-ACCESS-KEY
VAULTWARDEN_BACKUP_ZIP_PASSWORD=azurekv://VAULTWARDEN-BACKUP-ZIP-PASSWORD
