# Every variable compose.yaml uses, blank, so Dockhand's Populate can list them.
# Set the values in Dockhand, marked secret (Dockhand passes those to compose
# directly, and they override this file); never fill them in here.
VAULTWARDEN_BIND_ADDRESS=
DOMAIN=
ADMIN_TOKEN=
SIGNUPS_DOMAINS_WHITELIST=
SMTP_HOST=
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SSO_AUTHORITY=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_ZIP_PASSWORD=
